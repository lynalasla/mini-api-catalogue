    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.5",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "exceljs": "^4.4.0",
    "nodemon": "^3.1.11",
    "prisma": "^5.19.1"
  }
